<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keeps turn-by-turn navigation running (with an ongoing notification)
         while the visitor uses another app. See NavigationForegroundService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        Only for "Save to Device" in the Gallery, and only on Android 9 and
        below. From Android 10 the media store places the file itself and an
        app needs nothing granted to add its own media, so maxSdkVersion
        stops this being requested on versions where it does nothing — and on
        Android 13+ it is not a permission the system recognises at all.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- AR is a feature of the app, not a requirement to install it. Marked
         optional so phones without ARCore support can still use maps,
         itineraries and site content; the AR button is hidden for them. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!-- The CAMERA permission otherwise implies a required camera, which
         would hide the app from camera-less devices on Google Play. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".HistouryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Histoury">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <!-- "optional" lets the app install without Google Play Services
             for AR present; ArCoreApk then handles the on-demand install
             prompt when the user first opens an AR experience. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- Geospatial anchors resolve through the ARCore API on Google
             Cloud. Restrict this key to the ARCore API only. -->
        <meta-data
            android:name="com.google.android.ar.API_KEY"
            android:value="${ARCORE_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:label="@string/app_name"
            android:theme="@style/Theme.Histoury">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".location.GeofenceBroadcastReceiver"
            android:exported="false" />

        <service
            android:name=".location.NavigationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="true" />

        <receiver
            android:name=".location.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
